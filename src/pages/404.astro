---
import Base from '@/layouts/Base.astro';
import { url } from '@/lib/url';
---

<Base title="找不到页面" indexable={false}>
  <section class="container-x grid min-h-[60vh] place-items-center py-20 text-center">
    <div>
      <p class="font-display text-[clamp(6rem,22vw,14rem)] font-bold leading-none text-ink-3/30">404</p>
      <h1 class="-mt-4 text-3xl font-semibold md:text-5xl">这一拍被切掉了</h1>
      <p class="mt-4 text-ink-2">你要找的页面不存在，可能已经改名或者被移走。</p>
      <div class="mt-8 flex justify-center gap-3">
        <a href={url()} class="btn btn-accent">回首页</a>
        <a href={url('search/')} class="btn btn-ghost">搜索</a>
      </div>
    </div>
  </section>
</Base>
