---
import { getCollection, getEntries } from 'astro:content';
import { Image } from 'astro:assets';
import { trackThumb } from '@/lib/media';
import Base from '@/layouts/Base.astro';
import LiteYouTube from '@/components/LiteYouTube.astro';
import Confidence from '@/components/Confidence.astro';
import VideoShelf from '@/components/VideoShelf.astro';
import { url } from '@/lib/url';
import { SCENE, displayName } from '@/lib/labels';

const tracks = (await getCollection('tracks')).sort((a, b) => (a.data.year ?? 9999) - (b.data.year ?? 9999));
const withArtists = await Promise.all(tracks.map(async (t) => ({ t, artists: await getEntries(t.data.artists) })));
const scenes = Object.keys(SCENE) as (keyof typeof SCENE)[];
---

<Base title="曲目" description="中国区与世界的快嘴、chopper 代表曲目，附官方视频和来源。">
  <section class="container-x pt-14 md:pt-20">
    <p class="eyebrow">Tracks · {tracks.length}</p>
    <h1 class="mt-4 text-5xl font-bold md:text-7xl">曲目库</h1>
    <p class="mt-5 max-w-2xl text-lg text-ink-2">按年份排列。点击封面在页面内播放；优先收录艺人或厂牌官方上传的视频，非官方上传的会注明。</p>

    <div class="mt-8 flex flex-wrap gap-2" role="group" aria-label="按分区筛选" data-pagefind-ignore>
      <button class="t-btn chip cursor-pointer" data-value="" aria-pressed="true">全部</button>
      {scenes.map((k) => <button class="t-btn chip cursor-pointer" data-value={k} aria-pressed="false">{SCENE[k].name}</button>)}
      <button class="t-btn chip cursor-pointer" data-value="starter" aria-pressed="false">路人入门</button>
    </div>

    <p class="mt-6 text-sm text-ink-3 md:hidden">点一行展开播放器和介绍。</p>
    <div class="mt-4 grid grid-cols-1 gap-3 md:mt-10 md:gap-x-8 md:gap-y-16 lg:grid-cols-2">
      {
        withArtists.map(({ t, artists }) => {
          const thumb = trackThumb(t.data.youtube);
          return (
          <article id={t.id} class="track min-w-0 scroll-mt-24 max-md:rounded-2xl max-md:border max-md:border-line max-md:bg-surface max-md:p-2" data-scene={t.data.scene} data-starter={t.data.starter ? '1' : undefined}>
            {/* 手机：先只显示一行（缩略图 + 标题），点开再显示播放器和介绍 */}
            <button type="button" class="track-head flex w-full items-center gap-3 text-left md:hidden" aria-expanded="false" aria-controls={`body-${t.id}`}>
              <span class="relative aspect-video w-28 shrink-0 overflow-hidden rounded-lg bg-black">
                {thumb && <Image src={thumb} alt="" widths={[240]} sizes="112px" class="size-full object-cover" />}
              </span>
              <span class="min-w-0 flex-1">
                <span class="flex items-center gap-1.5 font-mono text-[11px] text-ink-3">
                  <span class="size-1.5 rounded-full" style={`background:${SCENE[t.data.scene].color}`} />{t.data.year ?? '年份待考'}
                </span>
                <span class="mt-0.5 line-clamp-2 block font-semibold leading-snug">{t.data.title}</span>
                <span class="block truncate text-xs text-ink-3">{t.data.credit}</span>
              </span>
              <svg viewBox="0 0 24 24" class="chev size-5 shrink-0 text-ink-3 transition" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6" /></svg>
            </button>
            <div id={`body-${t.id}`} class="track-body max-md:hidden max-md:px-1 max-md:pb-2 max-md:pt-3">
            <LiteYouTube id={t.data.youtube} title={`${t.data.title} ${t.data.credit}`} channel={t.data.youtubeChannel} official={t.data.officialUpload} bilibili={t.data.bilibili} netease={t.data.netease} />
            <div class="mt-5 flex flex-wrap items-center gap-2">
              <span class="chip"><span class="size-1.5 rounded-full" style={`background:${SCENE[t.data.scene].color}`} />{SCENE[t.data.scene].name}</span>
              {t.data.starter && <span class="chip">路人入门</span>}
              <span class="chip font-mono">{t.data.year ?? '年份待考'}</span>
              {t.data.confidence !== 'verified' && <Confidence level={t.data.confidence} />}
            </div>
            <h2 class="mt-3 text-2xl font-semibold max-md:sr-only">
              <a href={`#${t.id}`} class="hover:text-accent-text">{t.data.title}</a>
            </h2>
            <p class="mt-1 text-sm text-ink-3">{t.data.credit}{t.data.album && ` · 专辑 ${t.data.album}`}</p>
            <p class="mt-3 text-ink-2">{t.data.note}</p>
            <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
              {artists.map((a) => <a href={url(`choppers/${a.id}/`)} class="link-u text-ink hover:text-accent-text">{displayName(a.data)} →</a>)}
              {artists.length > 0 && <span class="text-ink-3">·</span>}
              {t.data.sources.map((s, i) => <a href={s.url} target="_blank" rel="noopener nofollow" class="link-u text-xs text-ink-3 hover:text-ink">来源 {i + 1} ↗</a>)}
            </div>
            </div>
          </article>
          );
        })
      }
    </div>
  </section>

  <section id="videos" class="container-x scroll-mt-24 pt-24">
    <p class="eyebrow">Videos</p>
    <h2 class="mt-3 text-3xl font-semibold md:text-5xl">测速、推荐和教学视频</h2>
    <p class="mt-4 max-w-3xl text-ink-2">B 站和 YouTube 上值得看的快嘴视频：语速测算、作品合集、怎么练。视频里的数字是作者自己测的，口径不一。</p>
    <div class="mt-8"><VideoShelf /></div>
  </section>
</Base>

<style>
  @media (max-width: 767.98px) {
    .track.open .track-body {
      display: block;
    }
    .track.open .chev {
      transform: rotate(180deg);
    }
  }
  .t-btn[aria-pressed='true'] {
    background: var(--ink);
    color: var(--bg);
    border-color: var(--ink);
  }
</style>

<script>
  const btns = [...document.querySelectorAll<HTMLButtonElement>('.t-btn')];
  const items = [...document.querySelectorAll<HTMLElement>('article.track')];
  const apply = (v: string) => {
    btns.forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.value === v)));
    items.forEach((el) => {
      const ok = !v || (v === 'starter' ? el.dataset.starter === '1' : el.dataset.scene === v);
      el.style.display = ok ? '' : 'none';
    });
    const p = new URLSearchParams(location.search);
    v ? p.set('scene', v) : p.delete('scene');
    history.replaceState(history.state, '', (p.size ? `?${p}` : location.pathname) + location.hash);
  };
  btns.forEach((b) => b.addEventListener('click', () => apply(b.dataset.value ?? '')));

  // 手机上的折叠行：点一下展开 / 收起；带锚点进来时直接展开那一首
  const setOpen = (el: HTMLElement, open: boolean) => {
    el.classList.toggle('open', open);
    el.querySelector('.track-head')?.setAttribute('aria-expanded', String(open));
  };
  items.forEach((el) => el.querySelector('.track-head')?.addEventListener('click', () => setOpen(el, !el.classList.contains('open'))));
  const openHash = () => {
    const el = location.hash && document.getElementById(decodeURIComponent(location.hash.slice(1)));
    if (el && el.classList.contains('track')) setOpen(el, true);
  };
  openHash();
  addEventListener('hashchange', openHash);
  const initial = new URLSearchParams(location.search).get('scene');
  // 带锚点直接跳到某首歌时，不做筛选，保证那首歌可见
  if (initial && !location.hash) apply(initial);
</script>
