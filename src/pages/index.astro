---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import ArtistCard from '@/components/ArtistCard.astro';
import TrackCard from '@/components/TrackCard.astro';
import SpeedChart from '@/components/SpeedChart.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Marquee from '@/components/Marquee.astro';
import { url } from '@/lib/url';
import { LANE, displayName } from '@/lib/labels';

const artists = await getCollection('artists');
const tracks = await getCollection('tracks');
const timeline = (await getCollection('timeline')).sort((a, b) => a.data.year - b.data.year);

const featured = artists.filter((a) => a.data.featured).sort((a, b) => a.data.activeSince - b.data.activeSince);
const homeTracks = ['worldwide-choppers', 'godzilla', 'look-at-me-now', 'jian-jiang', 'holocaust', 'june-27th']
  .map((id) => tracks.find((t) => t.id === id))
  .filter((t) => t !== undefined);

const sourceCount = new Set(
  [...artists.flatMap((a) => a.data.sources), ...tracks.flatMap((t) => t.data.sources), ...timeline.flatMap((t) => t.data.sources)].map((s) => s.url),
).size;
const countries = new Set(artists.map((a) => a.data.country)).size;

const stats = [
  { n: artists.length, label: '位人物' },
  { n: tracks.length, label: '首曲目' },
  { n: countries, label: '个国家' },
  { n: sourceCount, label: '条独立来源' },
];

// 首页右侧"步进器"的几档速度（音节/秒）
const presets = [
  { label: 'Twista 1992', v: 10.87 },
  { label: 'Godzilla', v: 10.65 },
  { label: '90 BPM 16 分', v: 6 },
];

const lanes = [
  { key: 'chopper', title: 'Chopper', zh: '快嘴', desc: '把音节剁碎：在一拍里塞进更多音节，同时咬字清楚、押韵密集。', href: 'learn/chopper/', count: artists.filter((a) => a.data.lane.includes('chopper')).length },
  { key: 'screw', title: 'Chopped & Screwed', zh: '降速切拍', desc: '把整首歌放慢到 60–70 BPM，再跳拍、重复、骤停，重新剪出结构。', href: 'learn/chopped-and-screwed/', count: artists.filter((a) => a.data.lane.includes('screw')).length },
  { key: 'sample', title: 'Sample Chop', zh: '切采样', desc: '把一段旧唱片切成碎片，放到打击垫上重新演奏成新的歌。', href: 'learn/sample-chop/', count: artists.filter((a) => a.data.lane.includes('sample')).length },
] as const;
---

<Base>
  <!-- ============ HERO ============ -->
  <section class="hero relative overflow-hidden">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="container-x relative grid items-center gap-12 pb-16 pt-14 lg:grid-cols-[1.15fr_1fr] lg:pb-24 lg:pt-24">
      <div>
        <p class="eyebrow">Chopper · Chopped &amp; Screwed · Sample Chop</p>
        <h1 class="mt-6 text-[clamp(3rem,9vw,7.2rem)] font-bold leading-[1.02]">
          把音节<br /><span class="chop-word">剁碎</span><span class="text-accent-text">。</span>
        </h1>
        <p class="mt-7 max-w-xl text-lg leading-relaxed text-ink-2">
          一个关于 <strong class="text-ink">chop</strong> 的档案馆：世界各地的快嘴说唱者、改变节奏的 DJ、切采样的制作人。每个数字都附来源，每条说法都标可信度。
        </p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href={url('choppers/')} class="btn btn-accent">进入人物库 →</a>
          <a href={url('lab/')} class="btn btn-ghost">去实验室听"快"有多快</a>
        </div>
        <dl class="mt-12 grid max-w-xl grid-cols-2 gap-6 border-t border-line pt-6 sm:grid-cols-4">
          {
            stats.map((s) => (
              <div>
                <dt class="sr-only">{s.label}</dt>
                <dd class="font-display text-3xl font-semibold tabular-nums">{s.n}</dd>
                <dd class="mt-1 text-xs text-ink-3">{s.label}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <!-- 步进器：直观展示每秒多少个音节 -->
      <div class="seq card relative p-5 shadow-[var(--shadow)] sm:p-7" data-rate={presets[0].v}>
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="eyebrow">Syllables / second</p>
            <p class="mt-2 font-display text-5xl font-semibold tabular-nums sm:text-6xl"><span class="seq-rate">{presets[0].v}</span></p>
          </div>
          <span class="seq-live chip"><span class="size-1.5 animate-pulse rounded-full bg-hot"></span>LIVE</span>
        </div>
        <div class="seq-grid mt-6 grid grid-cols-8 gap-1.5 sm:gap-2" aria-hidden="true">
          {Array.from({ length: 32 }, (_, i) => <span class:list={['cell', { beat: i % 8 === 0 }]} />)}
        </div>
        <p class="mt-4 text-xs text-ink-3">每个格子是一个音节。亮起的速度就是真实的每秒音节数。</p>
        <div class="mt-5 flex flex-wrap gap-2" role="radiogroup" aria-label="选择速度">
          {
            presets.map((p, i) => (
              <button type="button" role="radio" aria-checked={i === 0 ? 'true' : 'false'} class="seq-preset chip cursor-pointer transition" data-v={p.v}>
                {p.label} · {p.v}
              </button>
            ))
          }
        </div>
      </div>
    </div>

    <Marquee
      class="border-y border-line py-5 font-display text-3xl font-semibold text-ink-3 md:text-5xl"
      items={artists.map((a) => displayName(a.data))}
    />
  </section>

  <!-- ============ 三种 CHOP ============ -->
  <section class="container-x mt-28">
    <SectionHeading index="01" eyebrow="What is chop" title="一个词，三种音乐" href="learn/what-is-chop/" linkLabel="读入门文章" />
    <div class="grid gap-4 md:grid-cols-3">
      {
        lanes.map((l, i) => (
          <a href={url(l.href)} class="lane-card group card relative overflow-hidden p-6" style={`--lc:${LANE[l.key].color}`}>
            <div class="lane-art mb-8 h-24" aria-hidden="true" data-kind={l.key}>
              {l.key === 'chopper' && Array.from({ length: 28 }, (_, j) => <i style={`--h:${0.25 + Math.abs(Math.sin(j * 1.7)) * 0.75}`} />)}
              {l.key === 'screw' && (
                <svg viewBox="0 0 300 96" preserveAspectRatio="none" class="size-full">
                  <path d="M0 48 C 40 8, 80 8, 120 48 S 200 88, 240 48 S 290 20, 300 30" fill="none" stroke="var(--lc)" stroke-width="3" />
                  <path d="M0 58 C 40 18, 80 18, 120 58 S 200 98, 240 58 S 290 30, 300 40" fill="none" stroke="var(--lc)" stroke-width="1.5" opacity=".45" />
                </svg>
              )}
              {l.key === 'sample' && Array.from({ length: 8 }, (_, j) => <b style={`--o:${[3, 0, 6, 1, 7, 2, 5, 4][j]}`} />)}
            </div>
            <p class="eyebrow">{String(i + 1).padStart(2, '0')} · {l.zh}</p>
            <h3 class="mt-2 text-2xl font-semibold">{l.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-ink-2">{l.desc}</p>
            <p class="mt-6 flex items-center justify-between text-sm">
              <span class="text-ink-3">{l.count ? `收录 ${l.count} 位` : "专题建设中"}</span>
              <span class="transition group-hover:translate-x-1" style="color:var(--lc)">了解 →</span>
            </p>
          </a>
        ))
      }
    </div>
  </section>

  <!-- ============ 精选人物 ============ -->
  <section class="container-x mt-32">
    <SectionHeading index="02" eyebrow="Choppers" title="从芝加哥到海宁" href="choppers/" linkLabel="全部人物" />
    <div class="grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
      {featured.slice(0, 8).map((a) => <ArtistCard artist={a} />)}
    </div>
  </section>

  <!-- ============ 速度榜 ============ -->
  <section class="container-x mt-32">
    <SectionHeading index="03" eyebrow="Speed board" title="谁最快？先看数据口径" href="learn/measuring-speed/" linkLabel="数据怎么测">
      <p class="mt-4 max-w-2xl text-ink-2">官方认证、第三方测算、传闻说法混在一起比较没有意义。这里每一根条都标了可信度，鼠标移上去能看到口径和来源数量。</p>
    </SectionHeading>
    <div class="card p-5 sm:p-8"><SpeedChart /></div>
  </section>

  <!-- ============ 曲目 ============ -->
  <section class="container-x mt-32">
    <SectionHeading index="04" eyebrow="Tracks" title="必听曲目" href="tracks/" linkLabel="曲目库" />
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {homeTracks.map((t) => <div class="flex"><TrackCard track={t} /></div>)}
    </div>
  </section>

  <!-- ============ 时间线预览 ============ -->
  <section class="mt-32">
    <div class="container-x">
      <SectionHeading index="05" eyebrow="Timeline" title="四十年，越来越快" href="timeline/" linkLabel="完整时间线" />
    </div>
    <div class="tl-scroll container-x flex snap-x gap-4 overflow-x-auto pb-6">
      {
        timeline.map((e) => (
          <a href={url(`timeline/#${e.id}`)} class="tl-item card group flex w-64 shrink-0 snap-start flex-col p-5 transition hover:border-line-strong" style={`--lc:${LANE[e.data.lane].color}`}>
            <span class="font-display text-4xl font-semibold tabular-nums" style="color:var(--lc)">{e.data.year}</span>
            <span class="mt-3 font-semibold">{e.data.title}</span>
            <span class="mt-2 line-clamp-3 text-sm text-ink-3">{e.data.body}</span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- ============ 参与 ============ -->
  <section class="container-x mt-28">
    <div class="cta relative overflow-hidden rounded-[28px] p-8 sm:p-14">
      <p class="eyebrow !text-accent-ink/70">Contribute</p>
      <h2 class="mt-3 max-w-2xl text-3xl font-semibold text-accent-ink sm:text-5xl">你知道的 chopper，这里还没有？</h2>
      <p class="mt-4 max-w-xl text-accent-ink/80">推荐人物、补充曲目、纠正数据，都欢迎。每条投稿都会核实来源再收录。</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={url('community/')} class="btn bg-accent-ink text-accent hover:opacity-90">去讨论区</a>
        <a href={url('about/')} class="btn border border-accent-ink/30 text-accent-ink hover:border-accent-ink">收录标准</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero-glow {
    position: absolute;
    inset: -20% -10% auto auto;
    width: 70vw;
    height: 70vw;
    max-width: 900px;
    max-height: 900px;
    background: radial-gradient(closest-side, color-mix(in oklab, var(--accent) 16%, transparent), transparent);
    pointer-events: none;
  }
  /* "剁碎"：一道斜刀痕切过文字（用背景色的细条盖住，悬停时刀痕滑过） */
  .chop-word {
    position: relative;
    display: inline-block;
    color: var(--accent-text);
    overflow: hidden;
    padding-right: 0.04em;
  }
  .chop-word::after {
    content: '';
    position: absolute;
    left: -10%;
    right: -10%;
    top: 52%;
    height: 0.07em;
    background: var(--bg);
    transform: rotate(-9deg);
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .hero:hover .chop-word::after {
    transform: rotate(-9deg) translateY(-0.18em);
  }

  /* 步进器 */
  .cell {
    aspect-ratio: 1;
    border-radius: 6px;
    background: var(--surface-2);
    border: 1px solid var(--line);
    transition:
      background 0.25s ease,
      transform 0.25s ease;
  }
  .cell.beat {
    border-color: var(--line-strong);
  }
  .cell.on {
    background: var(--accent);
    border-color: var(--accent);
    transform: scale(0.9);
    transition: none;
  }
  .seq-preset[aria-checked='true'] {
    background: var(--accent);
    color: var(--accent-ink);
    border-color: var(--accent);
  }

  /* 三种 chop 的小图 */
  .lane-card {
    transition:
      transform 0.35s ease,
      border-color 0.3s ease;
  }
  @media (hover: hover) {
    .lane-card:hover {
      transform: translateY(-3px);
      border-color: color-mix(in oklab, var(--lc) 50%, var(--line));
    }
  }
  .lane-art[data-kind='chopper'] {
    display: flex;
    align-items: center;
    gap: 3px;
  }
  .lane-art[data-kind='chopper'] i {
    flex: 1;
    height: calc(var(--h) * 100%);
    background: var(--lc);
    border-radius: 3px;
    transform-origin: center;
    transition: transform 0.3s ease;
  }
  @media (hover: hover) {
    .lane-card:hover .lane-art i {
      animation: bar 0.35s ease-in-out infinite alternate;
    }
  }
  .lane-art[data-kind='chopper'] i:nth-child(odd) {
    animation-delay: -0.17s;
  }
  @keyframes bar {
    to {
      transform: scaleY(0.4);
    }
  }
  .lane-art[data-kind='sample'] {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    gap: 4px;
    align-items: stretch;
  }
  .lane-art[data-kind='sample'] b {
    border-radius: 6px;
    background: color-mix(in oklab, var(--lc) calc(35% + var(--o) * 9%), transparent);
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  @media (hover: hover) {
    .lane-card:hover .lane-art[data-kind='sample'] b {
      transform: translateY(calc((var(--o) - 3.5) * 5px));
    }
  }

  .tl-scroll {
    scrollbar-width: thin;
  }
  .cta {
    background:
      radial-gradient(120% 140% at 100% 0%, color-mix(in oklab, var(--accent) 60%, white) 0%, transparent 60%),
      var(--accent);
  }
</style>

<script>
  // 步进器：按真实的"每秒音节数"依次点亮格子。
  // 用定时器按节拍触发（而不是每帧执行），离开视口或切到后台就暂停。
  const root = document.querySelector<HTMLElement>('.seq');
  if (root) {
    const cells = [...root.querySelectorAll<HTMLElement>('.cell')];
    const rateEl = root.querySelector('.seq-rate')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let rate = Number(root.dataset.rate);
    let idx = 0;
    let timer = 0;
    let inView = true;

    const stop = () => {
      clearTimeout(timer);
      timer = 0;
    };
    const tick = () => {
      cells[idx]?.classList.remove('on');
      idx = (idx + 1) % cells.length;
      cells[idx].classList.add('on');
      timer = window.setTimeout(tick, 1000 / rate);
    };
    const start = () => {
      if (reduce || timer || !inView || document.hidden) return;
      timer = window.setTimeout(tick, 1000 / rate);
    };

    new IntersectionObserver(([e]) => {
      inView = e.isIntersecting;
      inView ? start() : stop();
    }).observe(root);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));

    root.querySelectorAll<HTMLButtonElement>('.seq-preset').forEach((b) => {
      b.addEventListener('click', () => {
        rate = Number(b.dataset.v);
        rateEl.textContent = String(rate);
        root.querySelectorAll('.seq-preset').forEach((x) => x.setAttribute('aria-checked', String(x === b)));
        stop();
        start();
      });
    });
    start();
  }
</script>
