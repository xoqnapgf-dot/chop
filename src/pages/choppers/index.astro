---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import ArtistCard from '@/components/ArtistCard.astro';
import { STYLE, SCENE } from '@/lib/labels';

// 中国区在前；各自按出道年份排
const artists = (await getCollection('artists')).sort(
  (a, b) => Number(b.data.country === 'CN') - Number(a.data.country === 'CN') || (a.data.activeSince ?? 9999) - (b.data.activeSince ?? 9999),
);
---

<Base title="人物" description="中国区和世界的快嘴、快歌与 chopper 人物库，可按分区和风格筛选。">
  <section class="container-x pt-14 md:pt-20">
    <p class="eyebrow">People · {artists.length}</p>
    <h1 class="mt-4 text-5xl font-bold md:text-7xl">人物库</h1>
    <p class="mt-5 max-w-2xl text-lg text-ink-2">
      每个人都标了风格：<span style="color:var(--style-track)">快歌</span>、<span style="color:var(--style-fast)">快嘴</span>或 <span style="color:var(--style-chopper)">Chopper</span>。快不等于 chopper，标签依据写在每个人的页面里。
    </p>

    <div class="filters sticky top-16 z-30 -mx-4 mt-10 border-y border-line px-4 py-4 md:mx-0 md:rounded-2xl md:border md:px-5" data-pagefind-ignore>
      <div class="flex flex-col gap-3 lg:flex-row lg:items-center">
        <label class="relative flex-1">
          <span class="sr-only">搜索人物</span>
          <svg class="pointer-events-none absolute left-3.5 top-1/2 size-4 -translate-y-1/2 text-ink-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
          <input id="q" type="search" placeholder="名字、城市、地区、标签…" autocomplete="off" class="w-full rounded-full border border-line bg-surface py-2.5 pl-10 pr-4 text-sm outline-none transition placeholder:text-ink-3 focus:border-line-strong" />
        </label>
        <div class="flex flex-wrap gap-2" role="group" aria-label="按分区筛选">
          <button class="f-btn chip" data-filter="scene" data-value="" aria-pressed="true">全部</button>
          {(Object.keys(SCENE) as (keyof typeof SCENE)[]).map((k) => <button class="f-btn chip" data-filter="scene" data-value={k} aria-pressed="false">{SCENE[k].name}</button>)}
        </div>
        <div class="flex flex-wrap gap-2" role="group" aria-label="按风格筛选">
          <button class="f-btn chip" data-filter="style" data-value="" aria-pressed="true">全部风格</button>
          {(Object.keys(STYLE) as (keyof typeof STYLE)[]).map((k) => <button class="f-btn chip" data-filter="style" data-value={k} aria-pressed="false">{STYLE[k].name}</button>)}
        </div>
      </div>
    </div>

    <p class="mt-6 text-sm text-ink-3" aria-live="polite"><span id="count">{artists.length}</span> 位</p>
    <div id="grid" class="mt-4 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
      {artists.map((a, i) => <ArtistCard artist={a} eager={i < 4} />)}
    </div>
    <p id="empty" class="hidden py-24 text-center text-ink-3">没有匹配的人物。换个关键词试试？</p>
  </section>
</Base>

<style>
  .filters {
    background: color-mix(in oklab, var(--bg) 94%, transparent);
  }
  .f-btn {
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .f-btn:hover {
    border-color: var(--line-strong);
    color: var(--ink);
  }
  .f-btn[aria-pressed='true'] {
    background: var(--ink);
    color: var(--bg);
    border-color: var(--ink);
  }
</style>

<script>
  type Key = 'scene' | 'style';
  const grid = document.getElementById('grid');
  if (grid) {
    const cards = [...grid.querySelectorAll<HTMLElement>('.artist-card')];
    const q = document.getElementById('q') as HTMLInputElement;
    const count = document.getElementById('count')!;
    const empty = document.getElementById('empty')!;
    const params = new URLSearchParams(location.search);
    const state = { scene: params.get('scene') ?? '', style: params.get('style') ?? '', text: params.get('q') ?? '' };
    q.value = state.text;

    const apply = () => {
      let n = 0;
      for (const c of cards) {
        const ok =
          (!state.scene || c.dataset.scene === state.scene) &&
          (!state.style || c.dataset.style === state.style) &&
          (!state.text || c.dataset.name!.includes(state.text.toLowerCase()));
        c.style.display = ok ? '' : 'none';
        if (ok) n++;
      }
      count.textContent = String(n);
      empty.classList.toggle('hidden', n > 0);
      document.querySelectorAll<HTMLButtonElement>('.f-btn').forEach((b) => {
        b.setAttribute('aria-pressed', String(state[b.dataset.filter as Key] === b.dataset.value));
      });
      const p = new URLSearchParams();
      if (state.scene) p.set('scene', state.scene);
      if (state.style) p.set('style', state.style);
      if (state.text) p.set('q', state.text);
      history.replaceState(history.state, '', p.size ? `?${p}` : location.pathname);
    };

    document.querySelectorAll<HTMLButtonElement>('.f-btn').forEach((b) => {
      b.addEventListener('click', () => {
        state[b.dataset.filter as Key] = b.dataset.value ?? '';
        apply();
      });
    });
    q.addEventListener('input', () => {
      state.text = q.value.trim();
      apply();
    });
    apply();
  }
</script>
