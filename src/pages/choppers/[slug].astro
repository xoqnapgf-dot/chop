---
import { getCollection, getEntries, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import StyleChip from '@/components/StyleChip.astro';
import Avatar from '@/components/Avatar.astro';
import Confidence from '@/components/Confidence.astro';
import Sources from '@/components/Sources.astro';
import LiteYouTube from '@/components/LiteYouTube.astro';
import VideoShelf from '@/components/VideoShelf.astro';
import { artistPhoto, artistBanner, artistColor, artistMedia } from '@/lib/media';
import { COUNTRY, SPEED_KIND, UNIT, SCENE, STYLE, WINDOW, displayName, placeLabel } from '@/lib/labels';
import { url } from '@/lib/url';
import nd24 from '@/data/nahdah-2024-countries.json';
import { collabPairs, collabHref, collabYear } from '@/lib/collabs';
import { seriesOf, member, epDate } from '@/lib/series';

export async function getStaticPaths() {
  // 与人物库同样的顺序：中国区在前，各自按出道年份
  const artists = (await getCollection('artists')).sort(
    (a, b) => Number(b.data.country === 'CN') - Number(a.data.country === 'CN') || (a.data.activeSince ?? 9999) - (b.data.activeSince ?? 9999),
  );
  return artists.map((artist, i) => ({
    params: { slug: artist.id },
    props: { artist, prev: artists[i - 1], next: artists[i + 1] },
  }));
}

interface Props {
  artist: CollectionEntry<'artists'>;
  prev?: CollectionEntry<'artists'>;
  next?: CollectionEntry<'artists'>;
}
const { artist, prev, next } = Astro.props;
const { data, id } = artist;
const { Content } = await render(artist);

const photo = artistPhoto(id);
const banner = data.useBanner ? artistBanner(id) : undefined;
const color = artistColor(id);
const media = artistMedia(id);
const country = COUNTRY[data.country];
const isCN = data.country === 'CN';
const title = displayName(data);
const subtitle = isCN ? data.name : data.nameZh;
const style = STYLE[data.style];
const related = data.related.length ? await getEntries(data.related) : [];

const tracks = (await getCollection('tracks', (t) => t.data.artists.some((a) => a.id === id))).sort((a, b) => (b.data.year ?? 0) - (a.data.year ?? 0));
const [lead, ...moreTracks] = tracks;
const hasVideos = (await getCollection('videos')).some((v) => v.data.artists.includes(id));
const events = (await getCollection('timeline', (e) => e.data.artist?.id === id)).sort((a, b) => a.data.year - b.data.year);
// 同台过的人：网易云合作记录（collabs）+ 曲库里同一首歌的收录人物（tracks）。按歌分组，同名歌只记一次
type SharedSong = { title: string; year: string; href: string; external: boolean; others: Set<string> };
const songMap = new Map<string, SharedSong>();
const addSong = (song: Omit<SharedSong, 'others'>, others: string[]) => {
  const key = song.title.toLowerCase();
  const cur = songMap.get(key) ?? { ...song, others: new Set<string>() };
  others.filter((o) => o !== id).forEach((o) => cur.others.add(o));
  if (cur.others.size) songMap.set(key, cur);
};
for (const p of (await collabPairs()).pairs.filter((p) => p.a === id || p.b === id))
  for (const c of p.songs) addSong({ title: c.data.title, year: collabYear(c), href: collabHref(c), external: true }, [p.a, p.b]);
for (const t of tracks) addSong({ title: t.data.title, year: String(t.data.year ?? ''), href: url(`tracks/#${t.id}`), external: false }, t.data.artists.map((a) => a.id));
// 上过的 chopper 系列（Undaground Choppers 等）：也算同台
const mySeries = await seriesOf(id);
for (const { series: sr, eps } of mySeries)
  for (const ep of eps)
    addSong({ title: ep.title, year: ep.date.slice(0, 4), href: url(`series/${sr.id}/#ep-${ep.no}`), external: false }, ep.lineup.map((r) => member(r).slug).filter((x): x is string => !!x));
const partnerIds = [...new Set([...songMap.values()].flatMap((s) => [...s.others]))];
const partnerEntries = new Map((partnerIds.length ? await getEntries(partnerIds.map((pid) => ({ collection: 'artists' as const, id: pid }))) : []).filter(Boolean).map((e) => [e.id, e]));
const sharedSongs = [...songMap.values()]
  .map((s) => ({ ...s, people: [...s.others].map((o) => partnerEntries.get(o)).filter((e): e is CollectionEntry<'artists'> => !!e) }))
  .filter((s) => s.people.length)
  .sort((a, b) => b.year.localeCompare(a.year));

const fmt = (d: string) => {
  const [y, m, dd] = d.split('-');
  return `${y} 年 ${Number(m)} 月 ${Number(dd)} 日`;
};

// NahDah 2024「每个国家最快的一位」：这个人是否是某国的代表（表里个别名字和档案名不同）
const ND24_ALIAS: Record<string, string> = { '6fbh': 'kvr' };
const nd24Row = nd24.find((r) => (ND24_ALIAS[r.rapper.toLowerCase()] ?? r.rapper.toLowerCase()) === id || r.rapper.toLowerCase() === data.name.toLowerCase());
const nd24Rank = nd24Row ? nd24.indexOf(nd24Row) + 1 : 0;

const facts = [
  data.realName && ['本名', data.realName],
  ['地区', placeLabel(data)],
  data.activeSince && ['出道', `${data.activeSince} 年`],
  data.born && ['出生', fmt(data.born)],
  data.died && ['去世', fmt(data.died)],
  nd24Row && ['2024 每国最快', `${nd24Row.nameZh}的代表 · ${nd24Row.sps.toFixed(2)}（《${nd24Row.song}》，${nd24Rank} / ${nd24.length}）`],
].filter(Boolean) as [string, string][];

const channelLabel = { official: '官方艺人频道', topic: 'YouTube 自动生成的 Topic 频道', label: '厂牌频道' };
---

<Base title={data.nameZh ? `${data.nameZh} ${data.name}` : data.name} description={data.tagline} image={photo?.src}>
  <article style={`--ac:${color}`}>
    <!-- ============ 人物头图 ============ -->
    <header class="relative overflow-hidden border-b border-line">
      <div class="absolute inset-0" aria-hidden="true">
        {banner ? (
          <Image src={banner} alt="" widths={[800, 1400, 2120]} sizes="100vw" class="size-full object-cover opacity-45" loading="eager" />
        ) : null}
        <div class="hero-shade absolute inset-0"></div>
      </div>

      <div class="container-x relative grid gap-8 pb-12 pt-10 md:grid-cols-[minmax(0,300px)_1fr] md:items-end md:gap-12 md:pb-16 md:pt-24">
        <div class="photo-frame relative w-48 overflow-hidden rounded-[26px] border border-white/10 sm:w-60 md:w-full">
          <Avatar id={id} data={data} widths={[300, 600]} sizes="300px" class="aspect-square w-full object-cover" eager />
        </div>
        <div class="min-w-0">
          <a href={url('choppers/')} class="eyebrow link-u hover:text-ink">← 人物库</a>
          <div class="mt-4 flex flex-wrap gap-2">
            <StyleChip style={data.style} size="md" />
            <span class="chip">{isCN ? `中国区 · ${data.region}` : country.name}</span>
          </div>
          <h1 class="mt-4 text-[clamp(2.2rem,10vw,4.5rem)] font-bold leading-[1] [overflow-wrap:anywhere]">{title}</h1>
          {subtitle && <p class="mt-2 font-display text-2xl text-ink-2 md:text-3xl">{subtitle}</p>}
          <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink-2">{data.tagline}</p>
          <div class="mt-6 flex flex-wrap gap-2">
            {data.tags.map((t) => <a href={url(`choppers/?q=${encodeURIComponent(t)}`)} class="chip hover:border-line-strong">#{t}</a>)}
          </div>
        </div>
      </div>
    </header>

    <!-- ============ 正文 ============ -->
    <div class="container-x mt-14 grid gap-14 lg:grid-cols-[minmax(0,1fr)_340px]">
      <div class="min-w-0">
        <section>
          <p class="eyebrow mb-5">简介</p>
          <div class="prose-chop"><Content /></div>
        </section>

        {lead && (
          <section class="mt-16">
            <p class="eyebrow mb-5">代表作</p>
            <h2 class="mb-1 text-2xl font-semibold">{lead.data.title}</h2>
            <p class="mb-5 text-sm text-ink-3">{lead.data.credit}{lead.data.year && ` · ${lead.data.year}`}{lead.data.album && ` · ${lead.data.album}`}</p>
            <LiteYouTube id={lead.data.youtube} title={`${lead.data.title} ${lead.data.credit}`} channel={lead.data.youtubeChannel} official={lead.data.officialUpload} bilibili={lead.data.bilibili} netease={lead.data.netease} />
            <p class="mt-4 text-ink-2">{lead.data.note}</p>

            {moreTracks.length > 0 && (
              <ul class="mt-8 grid gap-2">
                {moreTracks.map((t) => (
                  <li>
                    <a href={url(`tracks/#${t.id}`)} class="group flex items-center gap-4 rounded-xl border border-line p-3 transition hover:border-line-strong">
                      <span class="font-mono text-sm tabular-nums text-ink-3">{t.data.year ?? '—'}</span>
                      <span class="flex-1 font-semibold">{t.data.title}</span>
                      <span class="hidden text-sm text-ink-3 sm:block">{t.data.credit}</span>
                      <span class="text-ink-3 transition group-hover:translate-x-0.5 group-hover:text-ink">→</span>
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </section>
        )}

        {hasVideos && (
          <section class="mt-16">
            <p class="eyebrow mb-5">相关视频</p>
            <VideoShelf artist={id} limit={6} />
          </section>
        )}

        {mySeries.length > 0 && (
          <section class="mt-16">
            <p class="eyebrow mb-5">上过的系列 · {mySeries.reduce((n, x) => n + x.eps.length, 0)} 集</p>
            <ul class="grid gap-2.5 sm:grid-cols-2">
              {mySeries.map(({ series: sr, eps }) => (
                <li class="card p-4">
                  <a href={url(`series/${sr.id}/`)} class="link-u font-semibold hover:text-accent-text">{sr.data.name}</a>
                  <p class="mt-1 text-xs text-ink-3">{sr.data.host} · {sr.data.years}</p>
                  <div class="mt-3 flex flex-wrap gap-1.5">
                    {eps.map((ep) => (
                      <a href={url(`series/${sr.id}/#ep-${ep.no}`)} class="chip font-mono" title={`${ep.title} · ${epDate(ep)}`}>{ep.no}</a>
                    ))}
                  </div>
                </li>
              ))}
            </ul>
          </section>
        )}

        {sharedSongs.length > 0 && (
          <section class="mt-16">
            <p class="eyebrow mb-5">同台过的人 · {partnerEntries.size} 位 · {sharedSongs.length} 首</p>
            <ul class="grid gap-2.5">
              {sharedSongs.map((sg) => (
                <li class="card flex flex-col gap-3 p-4 sm:flex-row sm:items-center">
                  <p class="flex min-w-0 items-baseline gap-2 sm:w-64 sm:shrink-0">
                    <span class="w-9 shrink-0 font-mono text-xs text-ink-3">{sg.year}</span>
                    {sg.external ? (
                      <a href={sg.href} target="_blank" rel="noopener nofollow" class="link-u min-w-0 truncate font-semibold hover:text-accent-text">{sg.title} ↗</a>
                    ) : (
                      <a href={sg.href} class="link-u min-w-0 truncate font-semibold hover:text-accent-text">{sg.title}</a>
                    )}
                  </p>
                  <ul class="flex min-w-0 flex-wrap gap-1.5">
                    {sg.people.map((o) => (
                      <li>
                        <a href={url(`choppers/${o.id}/`)} class="flex items-center gap-1.5 rounded-full border border-line py-0.5 pl-0.5 pr-2.5 text-sm transition hover:border-line-strong hover:bg-surface-2">
                          <Avatar id={o.id} data={o.data} widths={[64]} sizes="24px" class="size-6 overflow-hidden rounded-full object-cover" />
                          {displayName(o.data)}
                        </a>
                      </li>
                    ))}
                  </ul>
                </li>
              ))}
            </ul>
            <p class="mt-3 text-xs text-ink-3">
              曲库和网易云署名，仅统计有档案的人物。{isCN && <a href={url('china/#links')} class="link-u hover:text-ink">看中国区合作网络 →</a>}
            </p>
          </section>
        )}

        {events.length > 0 && (
          <section class="mt-16">
            <p class="eyebrow mb-5">大事记</p>
            <ol class="relative ml-2 grid gap-6 border-l border-line pl-6">
              {events.map((e) => (
                <li class="relative">
                  <span class="absolute -left-[31px] top-1.5 size-2.5 rounded-full border-2 border-bg" style={`background:${SCENE[e.data.scene].color}`}></span>
                  <p class="font-mono text-sm text-ink-3">{e.data.year}</p>
                  <p class="mt-1 font-semibold">{e.data.title}</p>
                  <p class="mt-1 text-sm text-ink-2">{e.data.body}</p>
                </li>
              ))}
            </ol>
          </section>
        )}

        <section class="mt-16 border-t border-line pt-10">
          <Sources sources={data.sources} />
          {media?.photo ? (
            <p class="mt-6 text-xs text-ink-3">
              图片来源：
              <a class="link-u hover:text-ink" href={media.photo.url} target="_blank" rel="noopener">
                {media.photo.site}「{media.photo.name}」 ↗
              </a>
              ，抓取于 {media.fetchedAt}。版权归原作者所有。
            </p>
          ) : media ? (
            <p class="mt-6 text-xs text-ink-3">
              图片来源：
              {media.channelUrl && (
                <a class="link-u hover:text-ink" href={media.channelUrl} target="_blank" rel="noopener">
                  {data.youtube?.handle ?? data.name} · {channelLabel[media.kind as keyof typeof channelLabel]} ↗
                </a>
              )}
              {data.portrait && (
                <>
                  {media.channelUrl ? '；' : ''}人物照截取自官方视频{' '}
                  <a class="link-u hover:text-ink" href={`https://www.youtube.com/watch?v=${data.portrait.video}`} target="_blank" rel="noopener">
                    {data.portrait.video} ↗
                  </a>
                </>
              )}
              ，抓取于 {media.fetchedAt}。版权归原作者所有。
            </p>
          ) : (
            <p class="mt-6 text-xs text-ink-3">暂无可靠来源的照片，用名字做了文字头像。</p>
          )}
        </section>
      </div>

      <!-- ============ 侧栏 ============ -->
      <aside class="grid min-w-0 grid-cols-1 content-start gap-6 lg:sticky lg:top-24 lg:self-start">
        <div class="card style-card p-5" style={`--sc:${style.color}`}>
          <p class="eyebrow mb-3">风格判定</p>
          <StyleChip style={data.style} size="md" />
          <p class="mt-3 text-sm leading-relaxed text-ink-2">{data.styleNote}</p>
          {data.nearChop && (
            <div class="mt-4 rounded-xl border border-dashed p-3" style="border-color:color-mix(in oklab, var(--style-chopper) 55%, transparent)">
              <p class="text-xs font-semibold" style="color:var(--style-chopper)">接近 Chop</p>
              <p class="mt-1 text-sm leading-relaxed text-ink-2">{data.nearChop}</p>
            </div>
          )}
          <a href={url('learn/what-is-chop/')} class="mt-3 inline-block text-xs text-ink-3 link-u hover:text-ink">快嘴和 Chop 有什么区别？</a>
        </div>

        <div class="card p-5">
          <p class="eyebrow mb-4">档案</p>
          <dl class="grid gap-3 text-sm">
            {facts.map(([k, v]) => (
              <div class="grid grid-cols-[5.5rem_1fr] gap-3">
                <dt class="text-ink-3">{k}</dt>
                <dd class="text-ink">{v}</dd>
              </div>
            ))}
          </dl>
          {data.youtube && (
            <a href={`https://www.youtube.com/channel/${data.youtube.channelId}`} target="_blank" rel="noopener" class="btn btn-ghost mt-5 w-full justify-center text-sm">
              <svg viewBox="0 0 24 24" class="size-4" fill="currentColor"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8zM9.6 15.6V8.4l6.2 3.6-6.2 3.6z"/></svg>
              YouTube 频道
            </a>
          )}
        </div>

        {data.speed.length > 0 && (
          <div class="card p-5">
            <p class="eyebrow mb-4">速度数据</p>
            <ul class="grid gap-4">
              {data.speed.map((s) => (
                <li class="rounded-xl border border-line bg-surface-2 p-4">
                  <div class="flex items-start justify-between gap-2">
                    <p class:list={['font-display text-3xl font-semibold tabular-nums', { 'line-through decoration-2 opacity-60': s.confidence === 'debunked' }]}>
                      {s.value}
                      <span class="ml-1 font-sans text-xs font-normal text-ink-3">{UNIT[s.unit]}</span>
                    </p>
                    <Confidence level={s.confidence} />
                  </div>
                  <p class="mt-2 text-sm text-ink">{s.label}</p>
                  <p class="mt-1 text-xs text-ink-3">出处：{s.by} · {WINDOW[s.window].name} · {SPEED_KIND[s.kind]}</p>
                  {s.syllables && s.seconds && <p class="mt-1 font-mono text-xs text-ink-2">{s.syllables} ÷ {s.seconds} ≈ {(s.syllables / s.seconds).toFixed(2)}</p>}
                  {s.note && <p class="mt-2 text-xs leading-relaxed text-ink-2">{s.note}</p>}
                  <p class="mt-2 flex flex-wrap gap-x-3 text-xs">
                    {s.sources.map((src, i) => <a href={src.url} target="_blank" rel="noopener nofollow" class="link-u text-ink-3 hover:text-ink">来源 {i + 1} ↗</a>)}
                  </p>
                </li>
              ))}
            </ul>
            <a href={url('learn/measuring-speed/')} class="mt-4 inline-block text-xs text-ink-3 link-u hover:text-ink">这些数字怎么来的？</a>
          </div>
        )}

        {related.length > 0 && (
          <div class="card p-5">
            <p class="eyebrow mb-4">相关人物</p>
            <ul class="grid grid-cols-1 gap-2">
              {related.map((r) => (
                <li>
                  <a href={url(`choppers/${r.id}/`)} class="group flex items-center gap-3 rounded-xl p-1.5 transition hover:bg-surface-2">
                    <Avatar id={r.id} data={r.data} widths={[96]} sizes="44px" class="size-11 shrink-0 overflow-hidden rounded-lg object-cover" />
                    <span class="min-w-0 flex-1">
                      <span class="block truncate font-semibold">{displayName(r.data)}</span>
                      <span class="block truncate text-xs text-ink-3">{placeLabel(r.data)}</span>
                    </span>
                    <StyleChip style={r.data.style} />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </aside>
    </div>

    <!-- ============ 上一位 / 下一位 ============ -->
    <nav class="container-x mt-20 grid gap-4 sm:grid-cols-2" aria-label="浏览其他人物">
      {prev ? (
        <a href={url(`choppers/${prev.id}/`)} class="card group p-5 transition hover:border-line-strong">
          <span class="eyebrow">← 上一位</span>
          <span class="mt-2 block font-display text-xl">{displayName(prev.data)}</span>
        </a>
      ) : <span />}
      {next && (
        <a href={url(`choppers/${next.id}/`)} class="card group p-5 text-right transition hover:border-line-strong">
          <span class="eyebrow">下一位 →</span>
          <span class="mt-2 block font-display text-xl">{displayName(next.data)}</span>
        </a>
      )}
    </nav>
  </article>
</Base>

<style>
  .hero-shade {
    background:
      radial-gradient(80% 90% at 15% 100%, color-mix(in oklab, var(--ac) 35%, transparent), transparent 70%),
      radial-gradient(60% 80% at 90% 0%, color-mix(in oklab, var(--ac) 22%, transparent), transparent 70%),
      linear-gradient(180deg, color-mix(in oklab, var(--bg) 35%, transparent) 0%, var(--bg) 100%);
  }
  .style-card {
    border-top: 3px solid var(--sc);
  }
  .photo-frame {
    box-shadow: 0 40px 80px -30px color-mix(in oklab, var(--ac) 80%, transparent);
  }
</style>
