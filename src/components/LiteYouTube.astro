---
/**
 * 轻量播放器：先只显示本地缩略图，点击才加载 iframe。
 * 点击后：有 B 站视频就直接播 B 站（国内最稳，也不用等探测）；
 * 没有 B 站时先探测 YouTube 能不能连上，能连就播 YouTube；
 * 连不上或没有 YouTube，就用站内音频播放网易云（外链小播放器容易卡死，不再用）；
 * 网易云也放不了（会员歌曲等）时，直接给跳转按钮。
 */
import { Image } from 'astro:assets';
import { trackThumb } from '@/lib/media';

interface Props { id?: string; title: string; channel?: string; official?: boolean; bilibili?: string; netease?: number }
const { id, title, channel, official, bilibili, netease } = Astro.props;
const thumb = trackThumb(id) ?? (netease ? trackThumb(`ne-${netease}`) : undefined) ?? (bilibili ? trackThumb(`bv-${bilibili}`) : undefined);
const q = encodeURIComponent(title);
---

<div class="lite-yt group relative aspect-video overflow-hidden rounded-2xl border border-line bg-black" data-id={id} data-title={title} data-bv={bilibili} data-ne={netease}>
  {thumb && <Image src={thumb} alt="" widths={[480, 800, 1280]} sizes="(min-width: 1024px) 720px, 100vw" class="size-full object-cover opacity-90 transition duration-500 group-hover:scale-[1.02] group-hover:opacity-100" />}
  <button type="button" class="play absolute inset-0 grid place-items-center" aria-label={`播放：${title}`}>
    <span class="grid size-16 place-items-center rounded-full bg-accent text-accent-ink shadow-2xl transition group-hover:scale-110">
      <svg viewBox="0 0 24 24" class="ml-1 size-7" fill="currentColor"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l11-6.5a1 1 0 0 0 0-1.72l-11-6.5A1 1 0 0 0 8 5.5z"/></svg>
    </span>
  </button>
  <div class="yt-label pointer-events-none absolute inset-x-0 top-0 flex items-center justify-between gap-2 bg-gradient-to-b from-black/70 to-transparent p-3 text-xs text-white/85">
    <span class="truncate">{channel ?? (id ? '' : netease ? '网易云音乐' : 'B 站')}</span>
    {official !== undefined && <span class="shrink-0 rounded-full bg-black/50 px-2 py-0.5">{official ? '官方上传' : '非官方上传'}</span>}
  </div>
</div>
<p class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-xs text-ink-3">
  {
    bilibili ? (
      <a class="link-u hover:text-ink" href={`https://www.bilibili.com/video/${bilibili}/`} target="_blank" rel="noopener">B 站 ↗</a>
    ) : (
      <a class="link-u hover:text-ink" href={`https://search.bilibili.com/all?keyword=${q}`} target="_blank" rel="noopener">在 B 站搜 ↗</a>
    )
  }
  {
    netease ? (
      <a class="link-u hover:text-ink" href={`https://music.163.com/song?id=${netease}`} target="_blank" rel="noopener">网易云 ↗</a>
    ) : (
      <a class="link-u hover:text-ink" href={`https://music.163.com/#/search/m/?s=${q}`} target="_blank" rel="noopener">在网易云搜 ↗</a>
    )
  }
  {id && <a class="link-u hover:text-ink" href={`https://www.youtube.com/watch?v=${id}`} target="_blank" rel="noopener">YouTube ↗</a>}
  {/* YouTube 和国内平台优先；B 站、网易云都没有时，才给 Spotify */}
  {!bilibili && !netease && <a class="link-u hover:text-ink" href={`https://open.spotify.com/search/${q}`} target="_blank" rel="noopener">在 Spotify 搜 ↗</a>}
</p>

<script>
  // 先探测 YouTube 能否访问（国内通常不行），能访问才加载播放器，否则给出替代入口
  let reachable: Promise<boolean> | undefined;
  const probe = () =>
    (reachable ??= Promise.race([
      fetch('https://www.youtube-nocookie.com/favicon.ico', { mode: 'no-cors', cache: 'no-store' }).then(
        () => true,
        () => false,
      ),
      new Promise<boolean>((r) => setTimeout(() => r(false), 4000)),
    ]));

  // 网易云：站内 <audio> 直接放（外链 iframe 播放器容易卡死）；放不了就给跳转按钮
  function playNetease(btn: HTMLButtonElement, ne: string, title: string) {
    const page = `https://music.163.com/song?id=${ne}`;
    const wrap = document.createElement('div');
    wrap.className = 'absolute inset-0 flex flex-col items-center justify-center gap-2.5 bg-black/75 p-4 text-center text-white backdrop-blur-[2px]';
    const name = document.createElement('p');
    name.className = 'max-w-full truncate text-sm font-semibold';
    name.textContent = title;
    const audio = document.createElement('audio');
    audio.controls = true;
    audio.autoplay = true;
    audio.preload = 'auto';
    const src = `https://music.163.com/song/media/outer/url?id=${ne}.mp3`;
    audio.src = src;
    audio.className = 'w-full max-w-[420px]';
    const note = document.createElement('p');
    note.className = 'text-xs text-white/70';
    note.textContent = '网易云音乐 · 站内播放';
    const open = document.createElement('a');
    open.href = page;
    open.target = '_blank';
    open.rel = 'noopener';
    open.className = 'rounded-full bg-white/15 px-4 py-1.5 text-xs font-semibold hover:bg-white hover:text-black';
    open.textContent = '去网易云听 ↗';
    const fail = () => {
      if (wrap.dataset.failed) return;
      wrap.dataset.failed = '1';
      audio.remove();
      note.textContent = '这首在站内放不了（可能是会员歌曲），去网易云听：';
      open.className = 'rounded-full bg-white px-5 py-2 text-sm font-semibold text-black';
    };
    // 网易云的音频 CDN 偶尔会连不上某个节点，失败先换个请求重试两次，再不行才给跳转
    let tries = 0;
    audio.addEventListener('error', () => {
      if (tries < 2) {
        tries++;
        audio.src = `${src}&r=${Date.now()}`;
        audio.play().catch(() => {});
      } else fail();
    });
    // 15 秒还没开始加载数据，也当作放不了
    const timer = setTimeout(() => {
      if (audio.readyState < 2) fail();
    }, 15000);
    audio.addEventListener('canplay', () => clearTimeout(timer), { once: true });
    wrap.append(name, audio, note, open);
    // 顶部的"平台 / 官方上传"标签会压住歌名，播放时去掉
    btn.parentElement?.querySelector('.yt-label')?.remove();
    btn.replaceWith(wrap);
  }

  document.querySelectorAll<HTMLElement>('.lite-yt').forEach((el) => {
    const btn = el.querySelector<HTMLButtonElement>('.play');
    btn?.addEventListener('click', async () => {
      btn.disabled = true;
      btn.querySelector('span')?.classList.add('animate-pulse');
      const frame = (src: string, title: string, cls = 'absolute inset-0 size-full') => {
        const f = document.createElement('iframe');
        f.src = src;
        f.title = title;
        f.allow = 'autoplay; encrypted-media; fullscreen; picture-in-picture';
        f.allowFullscreen = true;
        f.referrerPolicy = 'no-referrer-when-downgrade';
        f.className = cls;
        return f;
      };
      const bv = el.dataset.bv;
      const ne = el.dataset.ne;
      const title = el.dataset.title ?? '';
      // 有 B 站视频：直接播 B 站
      if (bv) {
        el.replaceChildren(frame(`https://player.bilibili.com/player.html?bvid=${bv}&autoplay=1&danmaku=0&high_quality=1`, title));
        return;
      }
      if (!el.dataset.id || !(await probe())) {
        if (ne) {
          playNetease(btn, ne, title);
          return;
        }
        const q = encodeURIComponent(title);
        const box = document.createElement('div');
        box.className = 'absolute inset-0 grid place-items-center bg-black/80 p-6 text-center text-sm text-white';
        box.innerHTML = `<div><p class="font-semibold">当前网络无法连接 YouTube</p>
          <p class="mt-2 text-white/70">可以换个平台听：</p>
          <p class="mt-4 flex flex-wrap justify-center gap-2">
            <a class="rounded-full bg-white px-4 py-2 font-semibold text-black" href="https://search.bilibili.com/all?keyword=${q}" target="_blank" rel="noopener">B 站搜索</a>
            <a class="rounded-full bg-white px-4 py-2 font-semibold text-black" href="https://music.163.com/#/search/m/?s=${q}" target="_blank" rel="noopener">网易云搜索</a>
          </p></div>`;
        btn.replaceWith(box);
        return;
      }
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${el.dataset.id}?autoplay=1&rel=0`;
      iframe.title = el.dataset.title ?? '';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      iframe.className = 'absolute inset-0 size-full';
      el.replaceChildren(iframe);
    });
  });
</script>
