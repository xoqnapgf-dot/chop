<button
  type="button"
  class="theme-toggle grid size-9 place-items-center rounded-full border border-line text-ink-2 transition hover:border-line-strong hover:text-ink"
  aria-label="切换亮色/暗色主题"
>
  <svg class="sun size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
  <svg class="moon size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
</button>

<style>
  :global([data-theme='dark']) .sun,
  :global([data-theme='light']) .moon {
    display: none;
  }
</style>

<script>
  function initTheme() {
    document.querySelectorAll<HTMLButtonElement>('.theme-toggle').forEach((btn) => {
      btn.onclick = () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {
          /* 隐私模式下不可用，忽略 */
        }
      };
    });
  }
  document.addEventListener('astro:page-load', initTheme);
</script>
