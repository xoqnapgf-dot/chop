---
/**
 * 视频书架：测速视频、推荐合集、教学。点开是 B 站 / YouTube 原视频，封面存在本站。
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { videoCover } from '@/lib/media';

interface Props {
  kinds?: ('speed' | 'picks' | 'howto')[];
  scene?: 'china' | 'world';
  limit?: number;
}
const { kinds, scene, limit } = Astro.props;
const KIND = { speed: '测速', picks: '推荐', howto: '教学' } as const;
const all = (await getCollection('videos'))
  .filter((v) => (!kinds || kinds.includes(v.data.kind)) && (!scene || v.data.scene === scene))
  // 中国区在前，同区按类型（测速 → 推荐 → 教学）
  .sort((a, b) => (a.data.scene === b.data.scene ? 0 : a.data.scene === 'china' ? -1 : 1) || Object.keys(KIND).indexOf(a.data.kind) - Object.keys(KIND).indexOf(b.data.kind));
const list = limit ? all.slice(0, limit) : all;
// B 站给的时长是 "3:0" 这种，统一补成 "3:00"
const dur = (d: string) => d.split(':').map((p, i) => (i === 0 ? p : p.padStart(2, '0'))).join(':');
const href = (v: (typeof all)[number]) =>
  v.data.platform === 'bilibili' ? `https://www.bilibili.com/video/${v.id}/` : `https://www.youtube.com/watch?v=${v.id}`;
---

<ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
  {
    list.map((v) => {
      const cover = videoCover(v.id);
      return (
        <li class="flex">
          <a href={href(v)} target="_blank" rel="noopener" class="vcard card group flex w-full flex-col overflow-hidden">
            <div class="relative aspect-video overflow-hidden bg-black">
              {cover && <Image src={cover} alt="" widths={[320, 640]} sizes="(min-width: 1280px) 300px, (min-width: 640px) 45vw, 100vw" class="size-full object-cover transition duration-500 group-hover:scale-[1.03]" />}
              <span class="absolute left-2 top-2 rounded-full bg-black/65 px-2 py-0.5 text-[11px] font-semibold text-white">{v.data.platform === 'bilibili' ? 'B 站' : 'YouTube'}</span>
              {v.data.duration && <span class="absolute bottom-2 right-2 rounded bg-black/70 px-1.5 py-0.5 font-mono text-[11px] text-white">{dur(v.data.duration)}</span>}
            </div>
            <div class="flex flex-1 flex-col p-4">
              <p class="flex items-center gap-2 text-[11px] text-ink-3">
                <span class="kind rounded-full px-2 py-0.5 font-semibold" data-kind={v.data.kind}>{KIND[v.data.kind]}</span>
                <span>{v.data.scene === 'china' ? '中文' : '海外'}</span>
                <span class="ml-auto font-mono">{v.data.date.slice(0, 7)}</span>
              </p>
              <p class="mt-2 line-clamp-2 text-sm font-semibold leading-snug group-hover:underline">{v.data.title}</p>
              <p class="mt-1 text-xs text-ink-3">{v.data.author}</p>
              <p class="mt-2 text-xs leading-relaxed text-ink-2">{v.data.note}</p>
            </div>
          </a>
        </li>
      );
    })
  }
</ul>

<style>
  .kind {
    background: color-mix(in oklab, var(--accent) 18%, transparent);
    color: var(--accent-text);
  }
  .kind[data-kind='picks'] {
    background: color-mix(in oklab, var(--style-fast) 16%, transparent);
    color: var(--style-fast);
  }
  .kind[data-kind='howto'] {
    background: color-mix(in oklab, var(--style-track) 20%, transparent);
    color: var(--ink-2);
  }
</style>
