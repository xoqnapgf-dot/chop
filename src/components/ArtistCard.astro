---
import type { CollectionEntry } from 'astro:content';
import Avatar from './Avatar.astro';
import StyleChip from './StyleChip.astro';
import { artistColor } from '@/lib/media';
import { COUNTRY, displayName } from '@/lib/labels';
import { url } from '@/lib/url';

interface Props { artist: CollectionEntry<'artists'>; eager?: boolean }
const { artist, eager = false } = Astro.props;
const { data, id } = artist;
const color = artistColor(id);
const isCN = data.country === 'CN';
const title = displayName(data);
const sub = isCN ? data.name : data.nameZh;
const place = isCN ? (data.city === '未公开' ? '所在地未公开' : `${data.region} · ${data.city}`) : COUNTRY[data.country].name;
---

<a
  href={url(`choppers/${id}/`)}
  class="artist-card group relative block overflow-hidden rounded-[22px] border border-line bg-surface"
  style={`--ac:${color}`}
  data-country={data.country}
  data-scene={isCN ? 'china' : 'world'}
  data-style={data.style}
  data-name={`${data.name} ${data.nameZh ?? ''} ${data.realName ?? ''} ${data.city} ${data.region} ${data.tags.join(' ')}`.toLowerCase()}
>
  <div class="relative aspect-square overflow-hidden">
    <Avatar id={id} data={data} eager={eager} sizes="(min-width: 1024px) 300px, 50vw" class="size-full object-cover transition duration-700 ease-out group-hover:scale-[1.04]" />
    <div class="shade absolute inset-0"></div>
    <div class="absolute left-3 top-3 flex flex-wrap gap-1.5">
      <StyleChip style={data.style} onDark />
    </div>
    <div class="absolute inset-x-0 bottom-0 p-3 text-white sm:p-4">
      <p class="truncate font-mono text-[10px] tracking-widest text-white/70 sm:text-[11px]">{place}</p>
      <h3 class="mt-1 text-base font-semibold leading-tight sm:text-xl md:text-2xl">{title}</h3>
      {sub && <p class="truncate text-xs text-white/75 sm:text-sm">{sub}</p>}
    </div>
  </div>
  <div class="flex items-start justify-between gap-3 p-3 sm:p-4">
    <p class="line-clamp-2 text-xs leading-relaxed text-ink-2 sm:text-sm">{data.tagline}</p>
    <span class="mt-0.5 hidden size-8 shrink-0 place-items-center rounded-full border border-line text-ink-3 transition group-hover:border-transparent group-hover:bg-accent group-hover:text-accent-ink sm:grid">→</span>
  </div>
</a>

<style>
  .artist-card {
    transition:
      transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1),
      box-shadow 0.4s ease,
      border-color 0.3s ease;
  }
  @media (hover: hover) {
    .artist-card:hover {
      transform: translateY(-4px);
      border-color: color-mix(in oklab, var(--ac) 45%, var(--line));
      box-shadow: 0 24px 50px -24px color-mix(in oklab, var(--ac) 70%, transparent);
    }
  }
  .shade {
    background: linear-gradient(180deg, rgb(0 0 0 / 0.3) 0%, transparent 25%, transparent 40%, rgb(0 0 0 / 0.88) 100%);
  }
</style>
