---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { artistPhoto, artistColor } from '@/lib/media';
import { COUNTRY } from '@/lib/labels';
import { url } from '@/lib/url';

interface Props { artist: CollectionEntry<'artists'>; size?: 'md' | 'lg'; eager?: boolean }
const { artist, size = 'md', eager = false } = Astro.props;
const { data, id } = artist;
const photo = artistPhoto(id);
const color = artistColor(id);
const country = COUNTRY[data.country];
---

<a
  href={url(`choppers/${id}/`)}
  class="artist-card group relative block overflow-hidden rounded-[22px] border border-line bg-surface"
  style={`--ac:${color}`}
  data-country={data.country}
  data-lane={data.lane.join(' ')}
  data-name={`${data.name} ${data.nameZh ?? ''} ${data.realName ?? ''} ${data.city} ${data.tags.join(' ')}`.toLowerCase()}
  data-year={data.activeSince}
>
  <div class:list={['relative overflow-hidden', size === 'lg' ? 'aspect-[4/5]' : 'aspect-square']}>
    {
      photo ? (
        <Image
          src={photo}
          alt={`${data.nameZh ?? data.name} 的照片`}
          widths={[320, 480, 720]}
          sizes="(min-width: 1024px) 300px, (min-width: 640px) 45vw, 90vw"
          loading={eager ? 'eager' : 'lazy'}
          class="size-full object-cover transition duration-700 ease-out group-hover:scale-[1.04]"
          transition:name={`photo-${id}`}
        />
      ) : (
        <div class="grid size-full place-items-center bg-surface-2 font-display text-6xl text-ink-3">{data.name[0]}</div>
      )
    }
    <div class="shade absolute inset-0"></div>
    <div class="absolute left-3 top-3 flex gap-1.5">
      <span class="chip !border-white/15 !bg-black/45 !text-white backdrop-blur">{country.flag} {country.name}</span>
    </div>
    <div class="absolute inset-x-0 bottom-0 p-4 text-white">
      <p class="font-mono text-[11px] tracking-widest text-white/65">EST. {data.activeSince}</p>
      <h3 class="mt-1 text-base font-semibold leading-tight sm:text-xl md:text-2xl" transition:name={`name-${id}`}>{data.name}</h3>
      {data.nameZh && <p class="text-sm text-white/75">{data.nameZh}</p>}
    </div>
  </div>
  <div class="flex items-start justify-between gap-3 p-3 sm:p-4">
    <p class="line-clamp-2 text-xs leading-relaxed text-ink-2 sm:text-sm">{data.tagline}</p>
    <span class="mt-0.5 hidden size-8 shrink-0 sm:grid place-items-center rounded-full border border-line text-ink-3 transition group-hover:border-transparent group-hover:bg-accent group-hover:text-accent-ink">→</span>
  </div>
</a>

<style>
  .artist-card {
    transition:
      transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1),
      box-shadow 0.4s ease,
      border-color 0.3s ease;
  }
  .artist-card:hover {
    transform: translateY(-4px);
    border-color: color-mix(in oklab, var(--ac) 45%, var(--line));
    box-shadow: 0 24px 50px -24px color-mix(in oklab, var(--ac) 70%, transparent);
  }
  .shade {
    background: linear-gradient(180deg, transparent 45%, rgb(0 0 0 / 0.78));
  }
</style>
