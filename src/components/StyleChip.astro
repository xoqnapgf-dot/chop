---
import { STYLE, type Style } from '@/lib/labels';
interface Props { style: Style; size?: 'sm' | 'md'; onDark?: boolean }
const { style, size = 'sm', onDark = false } = Astro.props;
const s = STYLE[style];
---
<span
  class:list={['style-chip inline-flex items-center gap-1.5 rounded-full border font-semibold whitespace-nowrap', size === 'sm' ? 'px-2 py-0.5 text-[11px]' : 'px-3 py-1 text-xs', { 'on-dark': onDark }]}
  style={`--sc:${s.color}`}
  title={s.desc}
>
  <span class="size-1.5 rounded-full" style="background:var(--sc)" aria-hidden="true"></span>
  {s.name}
</span>

<style>
  .style-chip {
    color: var(--sc);
    border-color: color-mix(in oklab, var(--sc) 45%, transparent);
    background: color-mix(in oklab, var(--sc) 10%, transparent);
  }
  .style-chip.on-dark {
    color: #fff;
    background: rgb(0 0 0 / 0.55);
    border-color: rgb(255 255 255 / 0.18);
  }
</style>
