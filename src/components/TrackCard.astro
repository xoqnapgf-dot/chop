---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { trackThumb } from '@/lib/media';
import { url } from '@/lib/url';
import { SCENE } from '@/lib/labels';
import Confidence from './Confidence.astro';

interface Props { track: CollectionEntry<'tracks'> }
const { track } = Astro.props;
const t = track.data;
const thumb = trackThumb(t.youtube);
---

<!-- 手机上横排（左图右文），一首歌只占一小行；平板以上竖排卡片。宽度一律撑满格子 -->
<article class="track-card group card flex w-full min-w-0 flex-row overflow-hidden transition hover:border-line-strong sm:flex-col" data-scene={t.scene} data-year={t.year ?? 0} data-name={`${t.title} ${t.credit}`.toLowerCase()}>
  <a href={url(`tracks/#${track.id}`)} class="relative block aspect-video w-[42%] shrink-0 self-start overflow-hidden bg-black sm:w-full" aria-label={`${t.title}：去曲目库播放`}>
    {thumb && <Image src={thumb} alt={`${t.title} 视频缩略图`} widths={[400, 640]} sizes="(min-width: 1024px) 380px, (min-width: 640px) 45vw, 42vw" class="size-full object-cover transition duration-700 group-hover:scale-[1.04]" />}
    <span class="absolute bottom-1.5 left-1.5 rounded-full bg-black/60 px-2 py-0.5 font-mono text-[10px] text-white sm:bottom-3 sm:left-3 sm:px-2.5 sm:py-1 sm:text-[11px]">{t.year ?? '年份待考'}</span>
    <span class="absolute bottom-3 right-3 hidden size-10 place-items-center rounded-full bg-accent text-accent-ink opacity-0 shadow-xl transition group-hover:opacity-100 sm:grid">
      <svg viewBox="0 0 24 24" class="ml-0.5 size-4" fill="currentColor"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l11-6.5a1 1 0 0 0 0-1.72l-11-6.5A1 1 0 0 0 8 5.5z"/></svg>
    </span>
  </a>
  <div class="flex min-w-0 flex-1 flex-col gap-1 p-3 sm:gap-2 sm:p-4">
    <div class="hidden items-center gap-2 sm:flex">
      <span class="chip"><span class="size-1.5 rounded-full" style={`background:${SCENE[t.scene].color}`} />{SCENE[t.scene].name}</span>
      {t.starter && <span class="chip">路人入门</span>}
      {t.confidence !== 'verified' && <Confidence level={t.confidence} />}
    </div>
    <h3 class="line-clamp-2 text-[15px] font-semibold leading-snug sm:text-lg">{t.title}</h3>
    <p class="truncate text-xs text-ink-3 sm:whitespace-normal sm:text-sm">{t.credit}</p>
    <p class="mt-auto line-clamp-2 pt-1 text-xs text-ink-2 sm:text-sm">{t.note}</p>
  </div>
</article>
