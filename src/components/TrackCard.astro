---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { trackThumb } from '@/lib/media';
import { url } from '@/lib/url';
import LaneChip from './LaneChip.astro';
import Confidence from './Confidence.astro';

interface Props { track: CollectionEntry<'tracks'> }
const { track } = Astro.props;
const t = track.data;
const thumb = trackThumb(t.youtube);
---

<article class="track-card group card flex flex-col overflow-hidden transition hover:border-line-strong" data-lane={t.lane} data-year={t.year ?? 0} data-name={`${t.title} ${t.credit}`.toLowerCase()}>
  <a href={url(`tracks/#${track.id}`)} class="relative block aspect-video overflow-hidden bg-black">
    {thumb && <Image src={thumb} alt={`${t.title} 视频缩略图`} widths={[400, 640]} sizes="(min-width: 1024px) 380px, 90vw" class="size-full object-cover transition duration-700 group-hover:scale-[1.04]" />}
    <span class="absolute bottom-3 left-3 rounded-full bg-black/60 px-2.5 py-1 font-mono text-[11px] text-white">{t.year ?? '年份待考'}</span>
    <span class="absolute bottom-3 right-3 grid size-10 place-items-center rounded-full bg-accent text-accent-ink opacity-0 shadow-xl transition group-hover:opacity-100">
      <svg viewBox="0 0 24 24" class="ml-0.5 size-4" fill="currentColor"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l11-6.5a1 1 0 0 0 0-1.72l-11-6.5A1 1 0 0 0 8 5.5z"/></svg>
    </span>
  </a>
  <div class="flex flex-1 flex-col gap-2 p-4">
    <div class="flex items-center gap-2">
      <LaneChip lane={t.lane} short />
      {t.confidence !== 'verified' && <Confidence level={t.confidence} />}
    </div>
    <h3 class="text-lg font-semibold leading-snug">{t.title}</h3>
    <p class="text-sm text-ink-3">{t.credit}</p>
    <p class="mt-auto line-clamp-2 pt-1 text-sm text-ink-2">{t.note}</p>
  </div>
</article>
